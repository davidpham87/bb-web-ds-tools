;; shadow-cljs configuration
{:source-paths
 ["src" "test" "src/stories"]

 :deps true

 :dev-http {8080 "docs"}

 :builds
 {:app
  {:target :browser
   :output-dir "docs/js/compiled"
   :asset-path "/js/compiled"
   :compiler-options {:output-feature-set :es-next
                      :externs ["src/externs/webr.js"]}
   :devtools {:after-load bb-web-ds-tools.core/init}
   :modules {:main {:init-fn bb-web-ds-tools.core/init}}}
  :reader
  {:target :browser
   :output-dir "docs/js/compiled"
    :asset-path "/js/compiled"
    :modules {:reader {:init-fn bb-web-ds-tools.reader.core/init}}}
   :test
   {:target :browser-test
    :ns-regexp "-test$"
    :runner-ns shadow.test.karma
    :output-to "target/test/core.js"
    :test-dir "target/test"
    :module-loader true
    :compiler-options {:pretty-print true}
    :devtools {:autotest true}}
   :stories
   {:target :npm-module
    :output-dir "docs/js/stories"
    :entries [bb-web-ds-tools.stories.common-stories
              bb-web-ds-tools.stories.editor-stories
              bb-web-ds-tools.stories.view-stories
              bb-web-ds-tools.stories.layout-stories]}}}
